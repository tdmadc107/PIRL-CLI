{
  "name": "pirl-cli",
  "version": "0.1.0",
  "description": "PIRL CLI: a terminal UI that runs the PIRL framework (Plan – Implement – Review Layer) through the AI agent CLI you are already signed in to.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pirl": "dist/bin/pirl.js"
  },
  "files": [
    "dist",
    "bundled-framework"
  ],
  "engines": {
    "node": ">=22"
  },
  "pirl": {
    "frameworkVersion": "1.0.0"
  },
  "scripts": {
    "bundle-framework": "node scripts/bundle-framework.mjs",
    "build": "npm run bundle-framework && tsc -p tsconfig.build.json",
    "dev": "npm run bundle-framework && tsx src/bin/pirl.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run bundle-framework && vitest run",
    "prepack": "npm run build",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "ink": "7.1.1",
    "react": "19.2.9",
    "string-width": "8.3.0",
    "wrap-ansi": "10.0.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
